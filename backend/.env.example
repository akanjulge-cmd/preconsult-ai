# =================================================================
# PreConsult AI Backend - Production Environment Variables
# =================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Database Persistence
# For production persistence on Render/Supabase/Neon/Railway:
# DATABASE_URL=postgresql://preconsult_user:password@hostname:5432/preconsult_db
# For local development:
DATABASE_URL=sqlite:///./preconsult.db

# Artificial Intelligence & NLP
# Google Gemini API key for live clinical transcription & structured extraction
# (If blank, the system automatically uses the deterministic fallback medical NLP engine)
GEMINI_API_KEY=
MOCK_AI_FALLBACK=True

# CORS & Frontend Origins
# Set this to your deployed frontend domain (e.g., from Vercel)
FRONTEND_URL=https://preconsult-ai.vercel.app
# Optional comma-separated additional origins:
ALLOWED_ORIGINS=https://preconsult-ai.vercel.app,http://localhost:3000
